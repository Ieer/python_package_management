{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./tests",
    "-p",
    "test_offline_*.py"
  ],
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.offline-ui": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/package311/**": true,
    "**/bk/**": true,
    "**/download/**": true,
    "**/release/**": true,
    "**/.uv-cache/**": true
  },
  "search.exclude": {
    "**/package311": true,
    "**/bk": true,
    "**/download": true,
    "**/release": true,
    "**/.venv": true,
    "**/.offline-ui": true
  }
}
